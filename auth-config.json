{
  "authentication": {
    "enabled": true,
    "provider": "jwt",
    "tokenExpiry": "24h",
    "refreshTokenExpiry": "7d",
    "saltRounds": 12,
    "sessionTimeout": 1800,
    "multiFactorAuth": {
      "enabled": false,
      "providers": ["totp", "sms"]
    },
    "passwordPolicy": {
      "minLength": 12,
      "requireUppercase": true,
      "requireLowercase": true,
      "requireNumbers": true,
      "requireSpecialChars": true,
      "preventCommonPasswords": true,
      "maxPasswordAge": 90
    },
    "security": {
      "maxLoginAttempts": 5,
      "lockoutDuration": 900,
      "ipWhitelist": false,
      "requireEmailVerification": true,
      "csrfProtection": true,
      "httpOnlyCookies": true,
      "secureCookies": true
    }
  }
}
